# --- MongoDB Atlas ---
# Connection string del cluster M0 (free tier). Incluye usuario/contraseña de un
# database user con permisos de lectura/escritura sobre la base "helpdesk".
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/helpdesk?retryWrites=true&w=majority"

# --- Google Gemini (Google AI Studio) ---
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIza..."

# --- Auth.js ---
# Genera uno con: npx auth secret   (o: openssl rand -base64 32)
NEXTAUTH_SECRET="reemplaza-con-un-secreto-aleatorio"
NEXTAUTH_URL="http://localhost:3000"

# --- n8n (automatizaciones: email, Slack/Discord, Trello) ---
# URL del nodo "Webhook" del workflow importado en n8n Cloud (modo Production).
N8N_WEBHOOK_URL="https://tu-instancia.app.n8n.cloud/webhook/helpdesk"
# Secreto compartido: el backend lo manda en el header X-Helpdesk-Secret y el
# workflow de n8n lo valida antes de actuar, para que nadie más pueda dispararlo.
N8N_WEBHOOK_SECRET="reemplaza-con-otro-secreto-aleatorio"

# --- Semilla del primer admin (usado por scripts/create-admin.ts) ---
ADMIN_EMAIL="admin@tuempresa.com"
ADMIN_PASSWORD="cambia-esta-clave"
ADMIN_NAME="Administrador"
